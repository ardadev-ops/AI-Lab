layout {
    // Hier kommen die Tabs hin (oben)
    pane size=1 borderless=true {
        plugin location="zellij:tab-bar"
    }

    // Dein Haupt-Layout
    pane split_direction="vertical" {
        pane split_direction="horizontal" size="70%" {
            pane name="🤖 CLAUDE" command="powershell" {
                args "-NoExit" "-ExecutionPolicy" "Bypass" "-Command" ". \"$env:LAB_HOME\\goto_project.ps1\"; claude"
            }
            pane name="🧠 CODEX" command="powershell" {
                args "-NoExit" "-ExecutionPolicy" "Bypass" "-Command" ". \"$env:LAB_HOME\\goto_project.ps1\"; codex"
            }
        }
        
        pane split_direction="horizontal" size="30%" {
            pane split_direction="horizontal" {
                pane name="🎯 MISSION TO-DO Liste" command="powershell" {
                    args "-NoExit" "-ExecutionPolicy" "Bypass" "-Command" ". \"$env:LAB_HOME\\goto_project.ps1\"; & \"$env:LAB_HOME\\monitor.ps1\" MISSION.md"
                }
                pane name="📊 Token und Session Manager" command="powershell" {
                    args "-NoExit" "-ExecutionPolicy" "Bypass" "-Command" ". \"$env:LAB_HOME\\goto_project.ps1\"; & \"$env:LAB_HOME\\monitor.ps1\" USAGE.md"
                }
            }
            pane name="💬 Chat mit GEMINI" command="powershell" {
                args "-NoExit" "-ExecutionPolicy" "Bypass" "-Command" "gemini"
            }
        }
    }

    // Das hier bringt dir die Shortcut-Leiste unten zurück
    pane size=1 borderless=true {
        plugin location="zellij:status-bar"
    }
}