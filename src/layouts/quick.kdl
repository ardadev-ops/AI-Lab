layout {
    pane split_direction="vertical" {
        pane split_direction="horizontal" size="70%" {
            pane name="CLAUDE" command="powershell" size="65%" {
                args "-NoExit" "-ExecutionPolicy" "Bypass" "-Command" "claude"
            }
            pane name="RESEARCH_CHAT" command="powershell" {
                args "-NoExit" "-ExecutionPolicy" "Bypass" "-Command" "gemini"
            }
        }
        pane name="📊 Session Dashboard" command="powershell" size="30%" {
            args "-NoExit" "-ExecutionPolicy" "Bypass" "-Command" ". \"$env:LAB_HOME\\goto_project.ps1\"; & \"$env:LAB_HOME\\monitor.ps1\" DASHBOARD"
        }
    }

    pane size=1 borderless=true {
        plugin location="zellij:compact-bar"
    }
}
